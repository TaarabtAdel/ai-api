# Port (LMS mặc định AI_API_BASE_URL=http://127.0.0.1:7861)
PORT=7861

# Key OpenAI — chấp nhận cả tên OPEN_AI_KEY
OPENAI_API_KEY=
# OPEN_AI_KEY=

# Claude (tùy chọn — nếu trống, model Claude sẽ báo lỗi rõ ràng)
ANTHROPIC_API_KEY=

# Key LMS gửi lên (Bearer) — để trống = không kiểm tra (chỉ dev)
PROXY_API_KEY=dev-local-key

# Timeout ms khi gọi upstream
UPSTREAM_TIMEOUT_MS=120000
